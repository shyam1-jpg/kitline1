# Copy to server/.env and fill in.

# --- Email (temperature alerts + waitlist notifications to you) ---
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=shyam_1@hotmail.co.uk
# SMTP_PASS=your-app-password-here
# SMTP_FROM=Kiteline <shyam_1@hotmail.co.uk>
# NOTIFY_TO=extra@email.com

# --- SMS via Twilio (https://console.twilio.com) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+447XXXXXXXXX
# NOTIFY_PHONE=+447XXXXXXXXX

# REQUIRE_EMAIL_VERIFY=false       # optional — force off (verification auto-off when SMTP not set)

# --- Recipe AI (OpenAI — ingredients, method, hero photos) ---
# Platform key = only for owner + Kiteline-subscribed customers (you pay OpenAI, bill clients via Stripe add-on)
# OPENAI_API_KEY=sk-...
# RECIPE_AI_ENABLED=true          # must be true for Kiteline-hosted AI (off by default)
# RECIPE_AI_ADDON_GBP=12          # £/month per company (Stripe checkout in Settings)
# RECIPE_AI_TEXT_LIMIT=150        # text AI calls per month per subscribed company
# RECIPE_AI_IMAGE_LIMIT=15        # AI photos per month per subscribed company
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
# DATA_ENCRYPTION_KEY=            # optional — defaults to INGEST_KEY for encrypting customer BYOK keys
# SESSION_DAYS=14
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# ALLOWED_ORIGINS=https://kiteline.uk,https://www.kiteline.uk
# INGEST_KEY=generate-a-long-random-secret-here

# --- Free trial for new registrations ---
# TRIAL_DAYS=14
# TRIAL_MAX_USERS=5

# --- Stripe subscriptions (tiered by users: 1/5/10/20/50) ---
# Create account: https://dashboard.stripe.com
# Test keys start with sk_test_ / whsec_
# APP_URL=http://localhost:4001
# Production: APP_URL=https://kiteline.uk
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Webhook endpoint: https://kiteline.uk/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

# --- Sensors pushing to /api/ingest ---
# INGEST_KEY=your-random-secret

# --- Production owner login ---
# OWNER_EMAIL=shyam_1@hotmail.co.uk
# OWNER_PASSWORD=choose-a-strong-password

# Local demo mode (auto-create accounts). Off in production.
# DEMO_MODE=true
