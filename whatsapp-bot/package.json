{
  "name": "kiteline-whatsapp-bot",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp Cloud API chatbot — verify Meta's hub challenge, receive inbound messages, send text replies.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "simulate": "node scripts/simulate-inbound.js",
    "tunnel": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
