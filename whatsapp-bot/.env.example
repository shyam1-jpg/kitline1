# Copy to .env and fill in from Meta Developer → your app.
#   cp .env.example .env

# HTTP port for this webhook server
PORT=3000

# WhatsApp → API Setup → Phone number ID (digits, not the +44… display number)
WHATSAPP_PHONE_NUMBER_ID=

# Temporary token from API Setup, or a longer-lived system-user token
WHATSAPP_ACCESS_TOKEN=

# Any secret string you invent. Same value must be pasted into Meta's
# WhatsApp → Configuration → Verify token field.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string

# App Dashboard → App settings → Basic → App secret
# Used to check X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=

# Optional
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com
# WHATSAPP_BOT_NAME=Kiteline Assistant
